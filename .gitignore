/target
**/target/
**/*.rs.bk
*.voiddb
*.tmp
.DS_Store

# iOS — everything here is generated by scripts/build_ios.sh + `xcodegen
# generate`, never hand-edited. Committing it would drift from the Rust core
# it was built from the moment the core changes.
ios/generated/
ios/VoidFFI.xcframework/
ios/Void.xcodeproj/
ios/*.xcworkspace/
ios/DerivedData/

# Android — machine-specific SDK path, and build outputs generated by
# scripts/build_android.sh + Gradle, never hand-edited.
android/local.properties
android/app/src/main/jniLibs/
android/.gradle/
android/.kotlin/
android/app/build/
android/build/

# Claude Code's local scheduler lock: machine state, not source.
.claude/scheduled_tasks.lock

# The bindings check's Gradle build (scripts/check_android_bindings.sh).
tools/app-bindings/kotlin/.gradle/
tools/app-bindings/kotlin/.kotlin/
tools/app-bindings/kotlin/build/
