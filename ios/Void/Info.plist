<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>Void</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- FR-DIST-03: Void's cryptography goes well past the TLS-only export
	     exemption (ML-KEM, ML-DSA, XChaCha20-Poly1305, Argon2id implemented
	     or used directly, not merely HTTPS to a server). ITSAppUsesNonExemptEncryption
	     is deliberately absent, not set to NO: with it set to YES, App Store
	     Connect refuses an upload that lacks the ITSEncryptionExportComplianceCode
	     it issues once export documentation is approved; with it absent, App
	     Store Connect asks the export-compliance questions for each build,
	     and whoever distributes answers them. Setting it to NO to skip the
	     questions would be a false declaration. -->

	<!-- FR-DISC-01: QR scanning for contact establishment; D-033: video
	     calls. Asked for when the user scans a code or chooses a video call,
	     never at launch. -->
	<key>NSCameraUsageDescription</key>
	<string>Void uses the camera to scan a contact's invite code, and on video calls you
	place or answer. Nothing is recorded or saved.</string>

	<!-- D-024: calls. Without this key iOS terminates the app the first time
	     it touches the microphone. Asked for when the user chooses to call or
	     answer, never at launch. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Void uses the microphone only while you are on a call you placed or answered.
	Nothing is recorded or saved.</string>

	<!-- D-026 / FR-ID-02: the key that opens Void's data is held by the
	     Secure Enclave and released only after Face ID, Touch ID, or the
	     passcode. Required for the Face ID prompt that release shows. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Void uses Face ID to unlock the key that protects your messages on this phone.</string>

	<!-- A call keeps running when the screen locks or the user switches apps,
	     as a phone call does. Only while a call's audio session is active;
	     nothing else runs in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- The relay this build reaches: its onion address, which is its public
	     key (FR-TRANS-04). From the VOID_RELAY_ONION build setting in
	     project.yml, so a build can be pointed at another relay without
	     editing source: xcodebuild VOID_RELAY_ONION=<address>.onion -->
	<key>VoidRelayOnion</key>
	<string>$(VOID_RELAY_ONION)</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad multitasking requires every orientation; App Store Connect
	     refuses an iPad build without them. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
</dict>
</plist>
