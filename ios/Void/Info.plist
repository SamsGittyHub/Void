<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleDisplayName</key>
	<string>Void</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- FR-DIST-03: Void's cryptography goes well past the TLS-only export
	     exemption (ML-KEM, ML-DSA, XChaCha20-Poly1305, Argon2id implemented
	     or used directly, not merely HTTPS to a server). `true` here is the
	     honest answer, not the convenient one — it routes App Store Connect
	     through the standard export-compliance questionnaire on submission
	     rather than skipping it. That questionnaire is a distribution-time
	     step for whoever submits the build; this key only states the fact
	     the questionnaire is triggered by. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>

	<!-- FR-DISC-01: QR scanning for contact establishment. -->
	<key>NSCameraUsageDescription</key>
	<string>Void uses the camera to scan a contact's invite code. Nothing else. No photo is
	saved, and Void does not use the camera anywhere else in the app.</string>

	<!-- D-024: calls. Without this key iOS terminates the app the first time
	     it touches the microphone. Asked for when the user chooses to call or
	     answer, never at launch. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Void uses the microphone only while you are on a call you placed or answered.
	Nothing is recorded or saved.</string>

	<!-- D-026 / FR-ID-02: the key that opens Void's data is held by the
	     Secure Enclave and released only after Face ID, Touch ID, or the
	     passcode. Required for the Face ID prompt that release shows. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Void uses Face ID to unlock the key that protects your messages on this phone.</string>

	<!-- A call keeps running when the screen locks or the user switches apps,
	     as a phone call does. Only while a call's audio session is active;
	     nothing else runs in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad: all four orientations. An app that takes part in iPad
	     multitasking (UIRequiresFullScreen false, below) must declare all of
	     them, or App Store Connect refuses the upload. The phone list above
	     leaves out upside-down, as phones do. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
</dict>
</plist>
