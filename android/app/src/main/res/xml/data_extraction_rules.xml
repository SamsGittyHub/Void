<?xml version="1.0" encoding="utf-8"?>
<!-- FR-STOR-05: nothing Void writes leaves the device, by backup or by
     transfer to a new phone. Keys and messages are bound to this device by
     design (FR-REC-01); a copy elsewhere would be a copy nobody meant to make. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
